{
  "dashboard": {
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": {
            "type": "datasource",
            "uid": "grafana"
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        }
      ]
    },
    "description": "AWS HyperPod Slurm Job Exporter Dashboard",
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "links": [
      {
        "asDropdown": false,
        "icon": "external link",
        "includeVars": false,
        "keepTime": true,
        "tags": [
          "hyperpod-slurm"
        ],
        "targetBlank": false,
        "title": "",
        "tooltip": "",
        "type": "dashboards",
        "url": ""
      }
    ],
    "panels": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "description": "",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "shades"
            },
            "custom": {
              "align": "auto",
              "cellOptions": {
                "type": "auto"
              },
              "filterable": false,
              "inspect": false
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            }
          },
          "overrides": []
        },
        "gridPos": {
          "h": 10,
          "w": 24,
          "x": 0,
          "y": 0
        },
        "id": 1,
        "options": {
          "cellHeight": "sm",
          "footer": {
            "countRows": false,
            "enablePagination": true,
            "fields": [],
            "reducer": [
              "sum"
            ],
            "show": false
          },
          "frameIndex": 0,
          "showHeader": true,
          "sortBy": []
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "expr": "slurm_job_memory_rss_bytes{slurm_cluster_name=~\"${slurm_cluster_name}\", hostname=~\"${hostname}\", slurm_job_id=~\"${slurm_job_id}\", slurm_job_name=~\"${slurm_job_name}\", slurm_job_user=~\"${slurm_job_user}\", slurm_job_account=~\"${slurm_job_account}\", slurm_job_partition=~\"${slurm_job_partition}\"}",
            "format": "table",
            "instant": true,
            "legendFormat": "__auto",
            "refId": "RSS"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "expr": "slurm_job_thread_count{slurm_cluster_name=~\"${slurm_cluster_name}\", hostname=~\"${hostname}\", slurm_job_id=~\"${slurm_job_id}\", slurm_job_name=~\"${slurm_job_name}\", slurm_job_user=~\"${slurm_job_user}\", slurm_job_account=~\"${slurm_job_account}\", slurm_job_partition=~\"${slurm_job_partition}\"}",
            "format": "table",
            "instant": true,
            "legendFormat": "__auto",
            "refId": "Threads"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "expr": "slurm_job_process_count{slurm_cluster_name=~\"${slurm_cluster_name}\", hostname=~\"${hostname}\", slurm_job_id=~\"${slurm_job_id}\", slurm_job_name=~\"${slurm_job_name}\", slurm_job_user=~\"${slurm_job_user}\", slurm_job_account=~\"${slurm_job_account}\", slurm_job_partition=~\"${slurm_job_partition}\"}",
            "format": "table",
            "instant": true,
            "legendFormat": "__auto",
            "refId": "Tasks"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "expr": "rate(slurm_job_cpu_seconds_total{slurm_cluster_name=~\"${slurm_cluster_name}\", hostname=~\"${hostname}\", slurm_job_id=~\"${slurm_job_id}\", slurm_job_name=~\"${slurm_job_name}\", slurm_job_user=~\"${slurm_job_user}\", slurm_job_account=~\"${slurm_job_account}\", slurm_job_partition=~\"${slurm_job_partition}\"}[$__rate_interval])",
            "format": "table",
            "instant": true,
            "legendFormat": "__auto",
            "refId": "CPU"
          }
        ],
        "title": "Running Jobs Overview (Grouped by Job Name)",
        "transformations": [
          {
            "id": "joinByField",
            "options": {
              "byField": "slurm_job_id",
              "mode": "outer"
            }
          },
          {
            "id": "organize",
            "options": {
              "excludeByName": {},
              "includeByName": {},
              "renameByName": {
                "Value #RSS": "Memory",
                "Value #Threads": "Threads",
                "Value #Tasks": "Processes",
                "Value #CPU": "CPU Usage",
                "slurm_job_id": "Job ID",
                "slurm_job_name 1": "Job Name",
                "slurm_job_user 1": "User",
                "slurm_job_account 1": "Account",
                "slurm_job_partition 1": "Partition",
                "hostname 1": "Node"
              }
            }
          },
          {
            "id": "calculateField",
            "options": {
              "alias": "Mem",
              "mode": "reduceRow",
              "reduce": {
                "include": [
                  "Memory"
                ],
                "reducer": "sum"
              }
            }
          },
          {
            "id": "calculateField",
            "options": {
              "alias": "CPU %",
              "mode": "reduceRow",
              "reduce": {
                "include": [
                  "CPU Usage"
                ],
                "reducer": "sum"
              }
            }
          },
          {
            "id": "filterFieldsByName",
            "options": {
              "byVariable": false,
              "include": {
                "names": [
                  "Job ID",
                  "Job Name",
                  "User",
                  "Account",
                  "Partition",
                  "Node",
                  "Memory",
                  "Threads",
                  "Processes",
                  "CPU Usage",
                  "Mem",
                  "CPU %"
                ]
              }
            }
          },
          {
            "id": "groupToNestedTable",
            "options": {
              "fields": {
                "Job Name": {
                  "aggregations": [],
                  "operation": "groupby"
                },
                "Account": {
                  "aggregations": [],
                  "operation": "groupby"
                },
                "Mem": {
                  "aggregations": [
                    "mean"
                  ],
                  "operation": "aggregate"
                },
                "CPU %": {
                  "aggregations": [
                    "mean"
                  ],
                  "operation": "aggregate"
                }
              },
              "showSubframeHeaders": true
            }
          }
        ],
        "type": "table"
      },
      {
        "datasource": {
